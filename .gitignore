# CrimeLens AI — Git ignore (enterprise baseline)
# Never commit secrets, local env files, dependencies, or build artifacts.

# ---------------------------------------------------------------------------
# Environment & secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.*.local
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
venv
__pycache__/
__pycache__
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
node_modules
.pnpm-store/
.turbo/
.next/
.next
out/
dist/
dist
build/
build
coverage/
coverage
*.lcov
*.tsbuildinfo
.eslintcache
.parcel-cache/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# ML artifacts / caches (keep .gitkeep placeholders)
# ---------------------------------------------------------------------------
services/ml/artifacts/**
!services/ml/artifacts/.gitkeep
services/ml/datasets/**/*.parquet
services/ml/datasets/**/*.json
services/ml/reports/*.json
services/ml/reports/*.md
!services/ml/reports/.gitkeep
!services/ml/datasets/**/.gitkeep
data/.cache/**
!data/.cache/.gitkeep
.cache/

# ---------------------------------------------------------------------------
# IDE / OS
# ---------------------------------------------------------------------------
.idea/
.idea
.vscode/settings.json
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Generated clients (keep .gitkeep)
# ---------------------------------------------------------------------------
apps/web/src/shared/api/generated/**
!apps/web/src/shared/api/generated/.gitkeep

# ---------------------------------------------------------------------------
# Misc local
# ---------------------------------------------------------------------------
*.swp
*.swo
*~
.cache/

# Vercel
.vercel

