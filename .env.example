# Application
APP_ENV=local
APP_NAME=CrimeLens AI
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Feature flags
AI_ENABLED=true
ML_ENABLED=true
NETWORK_ENABLED=true

# PostgreSQL / PostGIS / pgvector
POSTGRES_USER=crimelens
POSTGRES_PASSWORD=crimelens
POSTGRES_DB=crimelens
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+psycopg://crimelens:crimelens@localhost:5432/crimelens

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Auth (Phase 2+)
JWT_SECRET=change-me-in-local-only-not-for-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# AI (disabled in Phase 1)
GEMINI_API_KEY=
QDRANT_URL=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
