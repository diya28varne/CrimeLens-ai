# =============================================================================
# CrimeLens AI — environment variable template
# =============================================================================
# Copy this file to `.env` and fill in your own values.
#
#   macOS / Linux:  cp .env.example .env
#   Windows (CMD):  copy .env.example .env
#   Windows (PS):   Copy-Item .env.example .env
#
# NEVER commit `.env` (or any file with real secrets) to GitHub.
# This file is safe to commit: placeholders and non-secret defaults only.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=
PORT=
APP_ENV=local
APP_NAME=CrimeLens AI
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
AI_ENABLED=false
ML_ENABLED=false
NETWORK_ENABLED=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL / PostGIS)
# DATABASE_URL is a conventional alias; the API primarily reads POSTGRES_URL.
# -----------------------------------------------------------------------------
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
POSTGRES_URL=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=

# -----------------------------------------------------------------------------
# Auth / JWT — use a long random secret in every non-local environment
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# AI / vector store — leave empty until configured; never put real keys here
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Web (Next.js public vars are exposed to the browser — no secrets here)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_PROVIDER=satellite
NEXT_PUBLIC_MAP_STYLE_URL=/map-styles/satellite-hybrid.json
# Exact Google Maps satellite/hybrid tiles (recommended). Create a key at
# https://console.cloud.google.com/google/maps-apis and enable Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
